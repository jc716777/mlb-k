# Copy to .env and fill in. Never commit the real .env.

# --- Kalshi API credentials (key-pair auth) ---
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Base URLs (per Kalshi docs, May 2026).
# Demo -- recommended; dry-run here first:
#   REST: https://external-api.demo.kalshi.co   WS: wss://external-api-ws.demo.kalshi.co
# Production:
#   REST: https://external-api.kalshi.com       WS: wss://external-api-ws.kalshi.com
#   (confirm the production WS host before live use)
KALSHI_REST_BASE=https://external-api.demo.kalshi.co
KALSHI_WS_BASE=wss://external-api-ws.demo.kalshi.co

# --- Live trading interlock ---
# The bot will REFUSE to send real orders unless this is exactly "true".
KALSHI_LIVE_TRADING_ENABLED=false

# --- Targets ---
# Kalshi market ticker for the game's moneyline (home team wins).
KALSHI_MARKET_TICKER=KXMLBGAME-25MAY22XXXYYY-XXX
# MLB StatsAPI gamePk for the same game.
MLB_GAME_PK=000000

# --- Strategy tuning (optional; sensible defaults in config.py) ---
ALPHA_THRESHOLD=0.06
# Only act on situations at or above this Leverage Index (0.0 disables).
MIN_LEVERAGE_INDEX=0.0
