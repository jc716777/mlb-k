# Copy to .env and fill in. Never commit the real .env.

# --- Kalshi API credentials (key-pair auth) ---
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Production: https://api.elections.kalshi.com
# Demo/paper: https://demo-api.kalshi.co
KALSHI_REST_BASE=https://demo-api.kalshi.co
KALSHI_WS_BASE=wss://demo-api.kalshi.co

# --- Live trading interlock ---
# The bot will REFUSE to send real orders unless this is exactly "true".
KALSHI_LIVE_TRADING_ENABLED=false

# --- Targets ---
# Kalshi market ticker for the game's moneyline (home team wins).
KALSHI_MARKET_TICKER=KXMLBGAME-25MAY22XXXYYY-XXX
# MLB StatsAPI gamePk for the same game.
MLB_GAME_PK=000000
